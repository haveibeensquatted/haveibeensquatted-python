{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LookupEvent",
  "type": "object",
  "required": ["permutation", "data"],
  "properties": {
    "permutation": {
      "type": "object",
      "required": ["domain", "kind"],
      "properties": {
        "domain": {
          "type": "object",
          "required": ["fqdn", "tld", "domain"],
          "properties": {
            "fqdn": { "type": "string" },
            "tld": { "type": "string" },
            "domain": { "type": "string" }
          }
        },
        "kind": {
          "type": "string",
          "enum": [
            "Addition",
            "Bitsquatting",
            "Hyphenation",
            "Insertion",
            "Omission",
            "Repetition",
            "Replacement",
            "Subdomain",
            "Transposition",
            "VowelSwap",
            "VowelShuffle",
            "Keyword",
            "Tld",
            "Homoglyph",
            "Mapped",
            "DoubleVowelInsertion",
            "CertificateTransparency",
            "FauxTld",
            "UserContext",
            "Unknown"
          ]
        }
      }
    },
    "data": {
      "type": "object",
      "required": ["permutation"],
      "properties": {
        "permutation": {
          "type": "object",
          "required": ["domain", "kind"],
          "properties": {
            "domain": {
              "type": "object",
              "required": ["fqdn", "tld", "domain"],
              "properties": {
                "fqdn": { "type": "string" },
                "tld": { "type": "string" },
                "domain": { "type": "string" }
              }
            },
            "kind": {
              "type": "string",
              "enum": [
                "Addition",
                "Bitsquatting",
                "Hyphenation",
                "Insertion",
                "Omission",
                "Repetition",
                "Replacement",
                "Subdomain",
                "Transposition",
                "VowelSwap",
                "VowelShuffle",
                "Keyword",
                "Tld",
                "Homoglyph",
                "Mapped",
                "DoubleVowelInsertion",
                "CertificateTransparency",
                "FauxTld",
                "UserContext",
                "Unknown"
              ]
            }
          }
        },
        "distance": { "type": "integer" },
        "ips": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["ip"],
            "properties": {
              "asn": {
                "type": "object",
                "properties": {
                  "number": { "type": ["integer", "null"] },
                  "organization": { "type": ["string", "null"] }
                }
              },
              "country": {
                "type": "object",
                "properties": {
                  "continent": { "type": ["string", "null"] },
                  "iso_code": { "type": ["string", "null"] }
                }
              },
              "ip": { "type": "string" }
            }
          }
        },
        "whois": {
          "oneOf": [{ "type": "string" }, { "type": "object" }]
        },
        "classification": {
          "type": "object",
          "required": ["legitimate", "phishing", "parked"],
          "properties": {
            "legitimate": { "type": "number" },
            "phishing": { "type": "number" },
            "parked": { "type": "number" }
          }
        },
        "http_banner": { "type": "string" },
        "technologies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dns_aaaa": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dns_a": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dns_mx": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dns_txt": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dns_cname": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dns_ns": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dns_svcb": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dns_https": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dns_caa": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dns_tlsa": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dns_srv": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dns_naptr": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dns_ptr": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dns_dnskey": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dns_ds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "unmodeled_operations": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {}
          }
        },
        "rdap": { "type": "object" },
        "screenshot_url": { "type": "string" },
        "registration_metadata": { "type": "object" },
        "redirect_chain": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["url"],
            "properties": {
              "url": { "type": "string" },
              "status": { "type": "integer" },
              "kind": {
                "type": "string",
                "enum": ["InitialRequest", "Http", "Javascript", "Client"]
              },
              "certificate": { "type": "object" }
            }
          }
        },
        "smtp_metadata": { "type": "object" },
        "nxdomain_metadata": { "type": "object" },
        "origin_x509": { "type": "object" },
        "passive_dns": { "type": "array" },
        "passive_tls": { "type": "object" },
        "certificate_transparency": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
